{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "backend-python/main.py": {
      "runtime": "vercel-python@4.2.0"
    }
  },
  "routes": [
    {
      "source": "/((?!api/).*)",
      "destination": "/backend-python/main.py"
    },
    {
      "source": "/api/(.*)",
      "destination": "/backend-python/main.py"
    }
  ],
  "tool": {
    "vercel": {
      "entrypoint": "backend-python/main:app"
    }
  }
}