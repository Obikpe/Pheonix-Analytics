{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": true
  },
  "functions": {
    "backend-python/main.py": {
      "runtime": "vercel-python@4.2.0"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/backend-python/main.py"
    }
  ]
}
