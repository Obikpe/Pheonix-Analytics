# The Pheonix Analytics - ENV (copy to .env)
# NEVER commit real .env to GitHub

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJ...anon
SUPABASE_SERVICE_ROLE_KEY=eyJ...service_role_secret_only_backend
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# JWT for Python backend (HS256)
JWT_SECRET=change-this-to-64-char-random-string-min-USE-openssl-rand-hex-32

# Paystack / Stripe / Flutterwave (test mode first)
PAYSTACK_SECRET=sk_test_your_paystack_secret
PAYSTACK_PUBLIC_KEY=pk_test_your_paystack_public
STRIPE_SECRET=sk_test_stripe
STRIPE_WEBHOOK_SECRET=whsec_test
FLUTTERWAVE_SECRET=FLWSECK_TEST

# Email (Resend or Nodemailer)
RESEND_API_KEY=re_xxx
ADMIN_EMAIL=you@thepheonixanalytics.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=app-password

# Frontend URL for CORS whitelist
FRONTEND_URL=https://thepheonixanalytics.com
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...anon

# Node Gateway
PORT=4000
NODE_ENV=production
